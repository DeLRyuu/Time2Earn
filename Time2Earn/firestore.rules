rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // 1. Config: Public read for client rate display, admin-only write
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Users: Read own document only; clients cannot modify balance, rank, or role
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'credits',
          'exp',
          'rank',
          'role',
          'isBanned',
          'isRestricted',
          'totalSessions',
          'totalCreditsEarned',
          'totalRedemptions',
          'redeemStreak',
          'lastRedeemDate',
          'streak',
          'streakRecoveryCharges',
          'debtAmount',
          'debtTier'
        ])
      );
      allow delete: if false; // Strict: Never delete user accounts
    }

    // 3. Rewards: Players read active rewards only; admin reads all and writes
    match /rewards/{rewardId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Session Requests: Players read own, create pending only; admin updates/resolves
    match /session_requests/{requestId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 5. Redemption Requests: Players read own, create pending only; admin updates/resolves
    match /redemption_requests/{requestId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 6. Reward Cooldowns: Players read own cooldown locks; admin writes
    match /reward_cooldowns/{cooldownId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 7. Debts: Players read own debt record; admin manages
    match /debts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // 8. Debt Payment Requests: Players read own, create pending only; admin updates/resolves
    match /debt_payment_requests/{requestId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 9. Debt History: Players read own history; admin writes
    match /debt_history/{historyId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 10. Credit Transactions: Players read own transactions; admin writes
    match /credit_transactions/{txId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 11. Logs: Admin reads; authenticated users & admin append; no update or delete allowed (append-only)
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if false; // Strict append-only
    }

    // 12. Arcade Sessions: Players read own sessions; create attempts; admin updates/deletes; client cannot edit results directly
    match /arcade_sessions/{sessionId} {
      allow read: if (resource != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 13. Public Leaderboard: Authenticated users read ranking projection; admin writes
    match /public_leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 14. Arcade Scores: Authenticated read; players create their own score record (number score); admin update/delete only
    match /arcade_scores/{scoreId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.score is number;
      allow update, delete: if isAdmin();
    }

    // 15. Arcade Profiles: Owner reads and writes non-sensitive stats only (no credits or exp manipulation); admin writes all
    match /arcade_profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits', 'exp'])
      );
      allow delete: if isAdmin();
    }
  }
}
